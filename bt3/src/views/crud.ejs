<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CRUD - Tạo User</title>
  <style>
    body {
      font-family: "Segoe UI", Roboto, system-ui, sans-serif;
      margin: 0;
      padding: 40px;
      background: #f9fafb;
      color: #111827;
    }
    h1 {
      margin-bottom: 12px;
      font-size: 28px;
      color: #1f2937;
    }
    p a {
      color: #2563eb;
      text-decoration: none;
      font-weight: 500;
    }
    p a:hover {
      text-decoration: underline;
    }
    form {
      max-width: 520px;
      background: #fff;
      padding: 24px 28px;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    }
    label {
      display: block;
      margin-top: 18px;
      margin-bottom: 6px;
      font-weight: 600;
      font-size: 14px;
      color: #374151;
    }
    input, select {
      width: 100%;
      padding: 12px;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      font-size: 15px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    input:focus, select:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
    }
    button {
      margin-top: 22px;
      padding: 12px 20px;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.25s, transform 0.1s;
    }
    .primary {
      background: #2563eb;
      color: #fff;
    }
    .primary:hover {
      background: #1d4ed8;
    }
    .primary:active {
      transform: scale(0.97);
    }
    .link {
      margin-left: 12px;
      font-size: 15px;
      color: #2563eb;
      text-decoration: none;
      font-weight: 500;
    }
    .link:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <h1>Thêm User</h1>
  <p><a href="/get-crud">Xem danh sách user</a></p>
  <form action="/post-crud" method="POST">
    <label>First name</label>
    <input name="firstName" required />
    <label>Last name</label>
    <input name="lastName" required />
    <label>Email</label>
    <input type="email" name="email" required />
    <label>Address</label>
    <input name="address" />
    <label>Gender</label>
    <select name="gender" required>
      <option value="Male">Male</option>
      <option value="Female">Female</option>
      <option value="Other" selected>Other</option>
    </select>
    <button class="primary" type="submit">Tạo</button>
    <a class="link" href="/get-crud">Danh sách</a>
  </form>
</body>
</html>
